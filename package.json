{
  "name": "devhub-hq",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @devhub/web --filter @devhub/api dev",
    "build": "pnpm -r --filter '@devhub/web' --filter '@devhub/api' build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:check": "pnpm --filter @devhub/database db:check",
    "e2e": "playwright test",
    "ci": "pnpm check && pnpm typecheck && pnpm db:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
