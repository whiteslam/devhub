# DevHub HQ — environment template. Copy to apps/web/.env.local (web) and
# export for apps/api. Never commit real values.

# --- Supabase (dashboard, read at runtime on the server; never sent to browsers)
# Local: printed by `supabase start` (API URL + publishable/anon key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key

# --- Dashboard
# Canonical public origin for auth email links and redirects. REQUIRED in
# production (request headers are never trusted for this).
DEVHUB_APP_URL=http://localhost:3000
# Number of trusted reverse proxies that append to X-Forwarded-For (Vercel,
# Traefik/Coolify, nginx: 1). Used to find the real client IP for rate limits.
DEVHUB_TRUSTED_PROXY_HOPS=1
# Self-service sign-up. Keep false in production: invite users from Supabase Auth.
DEVHUB_ALLOW_SIGNUP=false
DEVHUB_VERSION=0.1.0-dev

# --- API process (apps/api)
PORT=4000
MAX_BODY_BYTES=524288
REQUEST_TIMEOUT_MS=10000

# --- Server-only secrets used from Phase 2 onward (ingestion, integrations).
# The service-role key bypasses RLS: only apps/api and apps/worker may read it.
# SUPABASE_SERVICE_ROLE_KEY=
# 32-byte base64 key for AES-256-GCM encryption of provider tokens.
# DEVHUB_ENCRYPTION_KEY=
# HMAC pepper for hashing server telemetry credentials.
# DEVHUB_CREDENTIAL_PEPPER=
